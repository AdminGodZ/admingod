{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		-Server
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
