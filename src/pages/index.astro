---
import { Image } from "astro:assets";
import { ArrowUp, ArrowUpRight, Mail } from "lucide-react";
import {
  siLinux,
  siNextdotjs,
  siNodedotjs,
  siRailway,
  siReact,
  siRust,
  siTailwindcss,
  siTypescript,
} from "simple-icons";
import adminGodLogo from "@/assets/admingod_dark_transparent.png";
import adminSearchImage from "@/assets/adminsearch_transparent.png";
import aeralythImage from "@/assets/aeralyth_transparent.png";
import aetherzImage from "@/assets/aetherz_transparent.png";
import CareerRoadmap from "@/components/portfolio/career-roadmap.astro";
import { HeroTextReveal } from "@/components/portfolio/hero-text-reveal";
import LivingStarfield from "@/components/portfolio/living-starfield.astro";
import ScrollReveal from "@/components/portfolio/scroll-reveal.astro";
import ScrollSidebar from "@/components/portfolio/scroll-sidebar";
import ServiceStatus from "@/components/portfolio/service-status.astro";
import StackOrbit from "@/components/portfolio/stack-orbit.astro";
import VoidParticleField from "@/components/portfolio/void-particle-field";
import Layout from "@/layouts/layout.astro";

const projects = [
  {
    name: "AdminSearch",
    type: "Search engine",
    description:
      "A self-made search engine experience built around private, practical search, with SearXNG running as the underlying engine.",
    meta: "Next.js / SearXNG",
    image: adminSearchImage,
    imageWidths: [640, 750, 800, 828, 1080, 1280, 1600, 2048],
    href: "https://github.com/AdminGodZ/AdminSearch",
    liveUrl: "https://search.admingod.ch",
  },
  {
    name: "AetherZ",
    type: "Chess engine",
    description:
      "A self-programmed chess engine focused on move search, board evaluation, and building the core engine logic from scratch.",
    meta: "Custom Engine / Chess AI",
    image: aetherzImage,
    imageWidths: [640, 750, 800, 828, 1080, 1280, 1600, 2048],
    href: "https://github.com/AdminGodZ/AetherZ",
  },
  {
    name: "Aeralyth",
    type: "Self-hosted cloud",
    description:
      "A self-hosted cloud platform with encrypted vaults, file permissions, and storage backed by a Next.js frontend and Actix Web backend.",
    meta: "Next.js / Actix Web",
    image: aeralythImage,
    imageWidths: [640, 750, 800, 828, 1024],
    href: "https://github.com/AdminGodZ/Aeralyth",
    liveUrl: "https://cloud.admingod.ch",
  },
];

const stack = [
  { name: "Next.js", type: "Framework", icon: siNextdotjs },
  { name: "React", type: "UI library", icon: siReact },
  { name: "TypeScript", type: "Language", icon: siTypescript },
  { name: "Tailwind CSS", type: "Styling", icon: siTailwindcss },
  { name: "Node.js", type: "Runtime", icon: siNodedotjs },
  { name: "Rust", type: "Language", icon: siRust },
  { name: "Railway", type: "Cloud platform", icon: siRailway },
  { name: "Linux", type: "Platform", icon: siLinux },
];
---

<Layout>
    <main class="portfolio-page min-h-screen overflow-hidden text-foreground">
      <LivingStarfield />
      <ScrollReveal />
      <ScrollSidebar client:load />

      <section class="relative z-[1] flex min-h-[100svh] items-center overflow-hidden px-5 py-8 sm:px-8 lg:px-12">
        <div class="portfolio-void-bg absolute inset-0" />
        <VoidParticleField
          client:load
          className="void-particle-canvas pointer-events-none absolute bottom-0 left-1/2 h-[54vh] w-screen max-w-none -translate-x-1/2"
        />
        <div class="void-portal pointer-events-none absolute inset-x-0 bottom-0 h-[48vh]" />
        <div class="void-portal-fade pointer-events-none absolute inset-x-0 bottom-0 h-[42vh]" />

        <aside class="pointer-events-none absolute inset-y-0 right-[2vw] left-[58%] z-[4] hidden items-center justify-center lg:flex">
          <Image
            src={adminGodLogo}
            alt="AdminGod logo"
            width={900}
            height={900}
            widths={[640, 750, 828, 900, 1080, 1254]}
            layout="constrained"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
            sizes="44vw"
            class="h-auto w-[min(44vw,880px)] select-none object-contain opacity-95 drop-shadow-[0_38px_54px_rgba(0,0,0,0.22)] dark:hidden"
          />
          <img
            src="/admingod_white_transparent.png"
            alt="AdminGod logo"
            width="1254"
            height="1254"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
            sizes="44vw"
            class="hidden h-auto w-[min(44vw,880px)] select-none object-contain opacity-90 drop-shadow-[0_38px_54px_rgba(0,0,0,0.7)] dark:block"
          />
        </aside>

        <div class="relative z-10 mx-auto grid w-full max-w-7xl -translate-y-6 gap-10 lg:grid-cols-[minmax(0,0.56fr)_minmax(360px,0.44fr)] lg:items-center xl:-translate-y-8">
          <div class="max-w-[740px] pt-12 sm:pt-16 lg:pt-0">
            <HeroTextReveal
              eyebrow="Hi there, I call myself"
              title="AdminGod"
              description="and I love building software and hosting it myself."
              titleClassName="max-w-4xl text-[clamp(4rem,10vw,9rem)] font-black leading-[0.84] tracking-normal text-[#0c0c0c] dark:text-white"
              descriptionClassName="mt-8 max-w-2xl text-xl leading-8 text-black/68 dark:text-white/68 sm:text-2xl sm:leading-9"
              actionsClassName="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
            >
              <a
                href="/contact"
                class="inline-flex h-12 select-none items-center justify-center gap-2 border border-black bg-black px-5 text-sm font-semibold text-white transition-colors hover:bg-[#242424] dark:border-white dark:bg-white dark:text-black dark:hover:bg-[#d9d9d9]"
              >
                <Mail className="h-4 w-4" aria-hidden="true" />
                Contact me
              </a>
              <a
                href="https://github.com/AdminGodZ"
                target="_blank"
                rel="noreferrer"
                class="inline-flex h-12 select-none items-center justify-center gap-2 border border-black/12 bg-white/60 px-5 text-sm font-semibold text-black backdrop-blur-md transition-colors hover:border-black/25 hover:bg-white dark:border-white/14 dark:bg-white/6 dark:text-white dark:hover:border-white/28 dark:hover:bg-white/11"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25a5.65 5.65 0 0 0-1.5-3.95 5.4 5.4 0 0 0-.14-2.95S17.9 0 15.18 1.85a13.38 13.38 0 0 0-7 0C5.46 0 4.28.35 4.28.35a5.4 5.4 0 0 0-.14 2.95 5.65 5.65 0 0 0-1.5 3.95c0 5.63 3.44 6.88 6.72 7.25A4.8 4.8 0 0 0 8 18v4" />
                  <path d="M8 19c-3 .9-3-2-4-2" />
                </svg>
                GitHub
                <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
              </a>
            </HeroTextReveal>
          </div>

          <aside class="relative z-[5] flex justify-center pb-20 lg:hidden">
            <Image
              src={adminGodLogo}
              alt="AdminGod logo"
              width={760}
              height={760}
              widths={[640, 750, 760, 828, 1080, 1254]}
              layout="constrained"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              draggable="false"
              sizes="88vw"
              class="h-auto w-full max-w-[560px] select-none object-contain drop-shadow-[0_34px_48px_rgba(0,0,0,0.2)] dark:hidden"
            />
            <img
              src="/admingod_white_transparent.png"
              alt="AdminGod logo"
              width="1254"
              height="1254"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              draggable="false"
              sizes="88vw"
              class="hidden h-auto w-full max-w-[560px] select-none object-contain opacity-90 drop-shadow-[0_34px_48px_rgba(0,0,0,0.7)] dark:block"
            />
          </aside>
        </div>

        <div
          class="hero-section-dissolve pointer-events-none absolute inset-x-0 bottom-0 z-[6] h-[30vh]"
          aria-hidden="true"
        />
      </section>

      <section
        id="work"
        class="relative z-[7] -mt-10 px-5 pt-12 pb-24 text-foreground sm:px-8 lg:px-12"
      >
        <div class="mx-auto max-w-7xl">
          <div
            data-scroll-reveal="heading"
            class="mb-8 flex items-center gap-5"
          >
            <h2 class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76">
              Built projects
            </h2>
            <div class="h-px flex-1 bg-black/10 dark:bg-white/12" />
          </div>

          <div class="grid gap-5 lg:grid-cols-3">
            {projects.map((project, index) => {
              const cardClassName = `project-card group relative flex min-h-[230px] overflow-hidden rounded-lg border border-black/8 bg-white p-6 text-left no-underline shadow-[0_18px_38px_rgba(0,0,0,0.08)] ring-1 ring-white/80 dark:border-white/10 dark:bg-[#0a0a0a] dark:shadow-[0_18px_38px_rgba(0,0,0,0.6)] dark:ring-white/8 sm:min-h-[260px] ${project.href ? "cursor-pointer" : ""}`;
              const revealStyle = `--scroll-reveal-delay: ${index * 90}ms`;
              const cardContent = (
                <>
                  {project.image ? (
                    <Image
                      src={project.image}
                      alt={`${project.name} project visual`}
                      width={800}
                      widths={project.imageWidths}
                      layout="constrained"
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      sizes="(min-width: 1024px) 33vw, 100vw"
                      class="project-card-image project-card-image-uniform pointer-events-none absolute inset-0 h-full w-full select-none opacity-[0.92] dark:opacity-60"
                    />
                  ) : null}
                  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.18)_0%,rgba(255,255,255,0)_42%,rgba(255,255,255,0.96)_100%)] dark:bg-[linear-gradient(180deg,rgba(255,255,255,0.025)_0%,rgba(10,10,10,0.34)_42%,rgba(10,10,10,0.98)_100%)]" />
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-white/90 dark:bg-white/8" />
                  {project.liveUrl ? (
                    <ServiceStatus
                      url={project.liveUrl}
                      class="absolute top-4 left-4 z-10"
                    />
                  ) : null}
                  <div class="relative z-10 mt-auto flex w-full items-end justify-between gap-5">
                    <div>
                      <h3 class="text-3xl font-black tracking-tight text-black dark:text-white">
                        {project.name}
                      </h3>
                      {project.name !== "Under Construction" ? (
                        <p class="mt-1 text-sm font-semibold text-black/56 dark:text-white/58">
                          {project.type}
                        </p>
                      ) : null}
                      <p class="sr-only">
                        {project.description} {project.meta}
                      </p>
                    </div>
                    {project.name !== "Under Construction" ? (
                      <ArrowUpRight
                        className="project-card-arrow h-5 w-5 shrink-0 text-black dark:text-white"
                        aria-hidden="true"
                      />
                    ) : null}
                  </div>
                </>
              );

              if (project.href) {
                return (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noreferrer"
                    data-scroll-reveal="card"
                    style={revealStyle}
                    class={cardClassName}
                    aria-label={`Open ${project.name} on GitHub`}
                  >
                    {cardContent}
                  </a>
                );
              }

              return (
                <article
                  data-scroll-reveal="card"
                  style={revealStyle}
                  class={cardClassName}
                >
                  {cardContent}
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <CareerRoadmap />

      <section
        id="stack"
        class="relative z-[1] bg-transparent px-5 py-24 sm:px-8 lg:px-12"
      >
        <div class="mx-auto max-w-7xl">
          <div
            data-scroll-reveal="heading"
            class="mb-8 flex items-center gap-5"
          >
            <h2 class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76">
              Tools I work with
            </h2>
            <div class="h-px flex-1 bg-black/10 dark:bg-white/12" />
          </div>

          <div data-scroll-reveal="heading" class="hidden md:block">
            <StackOrbit items={stack} />
          </div>

          <ul class="grid grid-cols-2 gap-4 md:hidden">
            {stack.map((item, index) => (
              <li
                data-scroll-reveal="card"
                style={`--scroll-reveal-delay: ${(index % 4) * 70}ms`}
                class="group relative flex min-h-[170px] flex-col justify-between overflow-hidden rounded-lg border border-black/8 bg-white p-5 shadow-[0_18px_38px_rgba(0,0,0,0.06)] ring-1 ring-white/80 transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-black/16 hover:shadow-[0_24px_46px_rgba(0,0,0,0.1)] dark:border-white/10 dark:bg-[#0a0a0a] dark:shadow-[0_18px_38px_rgba(0,0,0,0.6)] dark:ring-white/8 dark:hover:border-white/20 dark:hover:shadow-[0_24px_46px_rgba(0,0,0,0.72)]"
              >
                <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(255,255,255,0)_36%,rgba(0,0,0,0.035)_100%)] dark:bg-[linear-gradient(145deg,rgba(255,255,255,0.025)_0%,rgba(255,255,255,0)_55%)]" />
                <svg
                  viewBox="0 0 24 24"
                  class="pointer-events-none absolute -top-7 -right-7 h-32 w-32 fill-current text-black/[0.035] transition-transform duration-500 group-hover:scale-110 dark:text-white/[0.035]"
                  aria-hidden="true"
                >
                  <path d={item.icon.path} />
                </svg>

                <div class="relative flex h-14 w-14 items-center justify-center rounded-md border border-black/8 bg-black/[0.025] dark:border-white/10 dark:bg-white/6">
                  <svg
                    viewBox="0 0 24 24"
                    class="h-8 w-8 fill-current text-black/78 dark:text-white/82"
                    aria-hidden="true"
                  >
                    <path d={item.icon.path} />
                  </svg>
                </div>

                <div class="relative mt-8">
                  <h3 class="text-lg font-bold text-black dark:text-white">{item.name}</h3>
                  <p class="mt-1 text-sm text-black/60 dark:text-white/58">{item.type}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <footer class="relative z-[1] border-t border-black/10 bg-white px-5 py-14 text-black dark:border-white/10 dark:bg-[#050505] dark:text-white sm:px-8 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
            <div data-scroll-reveal="footer" class="max-w-lg">
              <p class="text-2xl font-bold">AdminGod</p>
              <p class="mt-4 max-w-md leading-7 text-black/60 dark:text-white/65">
                Selected software projects and the tools I use to build them.
              </p>
            </div>

            <nav
              aria-label="Footer navigation"
              class="grid grid-cols-2 gap-x-12 gap-y-8 sm:gap-x-20"
            >
              <div
                data-scroll-reveal="footer"
                style="--scroll-reveal-delay: 90ms"
              >
                <p class="text-sm font-medium text-black/45 dark:text-white/50">
                  Explore
                </p>
                <div class="mt-4 flex flex-col gap-3">
                  <a
                    href="#work"
                    class="text-sm font-semibold text-black/70 transition-colors hover:text-black dark:text-white/70 dark:hover:text-white"
                  >
                    Projects
                  </a>
                  <a
                    href="#roadmap"
                    class="text-sm font-semibold text-black/70 transition-colors hover:text-black dark:text-white/70 dark:hover:text-white"
                  >
                    Roadmap
                  </a>
                  <a
                    href="#stack"
                    class="text-sm font-semibold text-black/70 transition-colors hover:text-black dark:text-white/70 dark:hover:text-white"
                  >
                    Tools
                  </a>
                </div>
              </div>

              <div
                data-scroll-reveal="footer"
                style="--scroll-reveal-delay: 180ms"
              >
                <p class="text-sm font-medium text-black/45 dark:text-white/50">
                  Connect
                </p>
                <div class="mt-4 flex flex-col gap-3">
                  <a
                    href="https://github.com/AdminGodZ"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-black/70 transition-colors hover:text-black dark:text-white/70 dark:hover:text-white"
                  >
                    GitHub
                    <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
                  </a>
                  <a
                    href="https://github.com/AdminGodZ/admingod"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-black/70 transition-colors hover:text-black dark:text-white/70 dark:hover:text-white"
                  >
                    Site source
                    <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </nav>
          </div>

          <div
            data-scroll-reveal="footer"
            style="--scroll-reveal-delay: 120ms"
            class="mt-14 flex flex-col gap-4 border-t border-black/10 pt-6 text-sm text-black/50 dark:border-white/10 dark:text-white/55 sm:flex-row sm:items-center sm:justify-between"
          >
            <p>© 2026 AdminGod</p>
            <a
              href="/"
              class="inline-flex items-center gap-2 font-semibold text-black/65 transition-colors hover:text-black dark:text-white/65 dark:hover:text-white"
            >
              Back to top
              <ArrowUp className="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </footer>
    </main>
</Layout>
