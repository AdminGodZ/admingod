---
import { Code } from "astro:components";
import { render } from "astro:content";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import {
  ArrowLeft,
  Check,
  Copy,
  Download,
  ExternalLink,
  FileCode2,
  FileText,
} from "lucide-react";
import ResearchLayout from "@/layouts/research-layout.astro";
import {
  formatResearchDate,
  getResearch,
  type ResearchEntry,
} from "@/lib/research";

export async function getStaticPaths() {
  const entries = await getResearch();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: ResearchEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const latexSource = await readFile(
  join(process.cwd(), "public", data.source.replace(/^\//, "")),
  "utf8",
);
const downloadStem = `${entry.id}-v${data.version}`;
---

<ResearchLayout
  title={`${data.title} - AdminGod math research`}
  description={data.summary}
  pageType="article"
>
  <article class="relative z-[1] px-5 pt-12 pb-28 sm:px-8 sm:pt-16 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <a
        href="/research"
        class="group inline-flex items-center gap-2 text-sm font-semibold text-black/58 transition-colors hover:text-black dark:text-white/58 dark:hover:text-white"
      >
        <ArrowLeft className="size-4 transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true" />
        All research
      </a>

      <header class="mt-12">
        <div class="max-w-6xl border-b border-black/10 pb-12 dark:border-white/10">
          <p class="text-sm font-semibold text-blue-700/72 dark:text-blue-300/72">
            {data.problem}
          </p>
          <h1 class="mt-5 text-[clamp(2.8rem,6.5vw,5.9rem)] font-black leading-[0.94] tracking-[-0.052em] text-black dark:text-white">
            {data.title}
          </h1>
          <p class="mt-8 max-w-4xl text-lg leading-8 text-black/58 dark:text-white/58 sm:text-xl sm:leading-9">
            {data.summary}
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href={data.pdf}
              target="_blank"
              rel="noreferrer"
              class="inline-flex h-12 items-center gap-2 border border-black bg-black px-5 text-sm font-semibold text-white transition-colors hover:bg-[#242424] dark:border-white dark:bg-white dark:text-black dark:hover:bg-[#d9d9d9]"
            >
              <FileText className="size-4" aria-hidden="true" />
              Open PDF
              <ExternalLink className="size-4" aria-hidden="true" />
            </a>
            <a
              href={data.pdf}
              download={`${downloadStem}.pdf`}
              class="inline-flex h-12 items-center gap-2 border border-black/12 bg-white/60 px-5 text-sm font-semibold text-black transition-colors hover:border-black/25 hover:bg-white dark:border-white/14 dark:bg-white/6 dark:text-white dark:hover:border-white/28 dark:hover:bg-white/11"
            >
              <Download className="size-4" aria-hidden="true" />
              PDF
            </a>
            <a
              href={data.source}
              download={`${downloadStem}.tex`}
              class="inline-flex h-12 items-center gap-2 border border-black/12 bg-white/60 px-5 text-sm font-semibold text-black transition-colors hover:border-black/25 hover:bg-white dark:border-white/14 dark:bg-white/6 dark:text-white dark:hover:border-white/28 dark:hover:bg-white/11"
            >
              <FileCode2 className="size-4" aria-hidden="true" />
              LaTeX
            </a>
          </div>
        </div>

        <dl class="grid border-b border-black/10 sm:grid-cols-3 dark:border-white/10">
          <div class="py-6 sm:border-r sm:border-black/10 sm:pr-6 dark:sm:border-white/10">
            <dt class="text-sm font-medium text-black/42 dark:text-white/42">Field</dt>
            <dd class="mt-2 font-semibold text-black/76 dark:text-white/76">{data.field}</dd>
          </div>
          <div class="border-t border-black/10 py-6 sm:border-t-0 sm:border-r sm:px-6 dark:border-white/10 dark:sm:border-white/10">
            <dt class="text-sm font-medium text-black/42 dark:text-white/42">Release</dt>
            <dd class="mt-2 font-semibold text-black/76 dark:text-white/76">Version {data.version}</dd>
          </div>
          <div class="border-t border-black/10 py-6 sm:border-t-0 sm:pl-6 dark:border-white/10">
            <dt class="text-sm font-medium text-black/42 dark:text-white/42">Updated</dt>
            <dd class="mt-2 font-semibold text-black/76 dark:text-white/76">{formatResearchDate(data.updatedAt)}</dd>
          </div>
        </dl>

        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-black/46 dark:text-white/46">
          {data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </header>

      <div class="mt-20 max-w-4xl">
        <div class="research-prose max-w-4xl">
          <Content />
        </div>

        {
          data.externalUrl && (
            <a
              href={data.externalUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-blue-700/76 transition-colors hover:text-blue-800 dark:text-blue-300/76 dark:hover:text-blue-200"
            >
              Original problem
              <ExternalLink className="size-4" aria-hidden="true" />
            </a>
          )
        }
      </div>

      <section class="mt-24" aria-labelledby="paper-heading">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <h2 id="paper-heading" class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76">
            Read the paper
          </h2>
          <div class="hidden h-px flex-1 bg-black/10 dark:bg-white/12 sm:block"></div>
          <p class="text-sm font-medium text-black/42 dark:text-white/42">Version {data.version}</p>
          <a
            href={data.pdf}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-black/62 transition-colors hover:text-black dark:text-white/62 dark:hover:text-white"
          >
            Open full screen
            <ExternalLink className="size-4" aria-hidden="true" />
          </a>
        </div>
        <div class="overflow-hidden rounded-lg border border-black/10 bg-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] dark:border-white/12 dark:bg-[#111] dark:shadow-[0_20px_50px_rgba(0,0,0,0.58)]">
          <object class="research-pdf-viewer" data={`${data.pdf}#view=FitH`} type="application/pdf">
            <div class="p-8 text-black dark:text-white">
              This browser cannot display the PDF inline.
              <a href={data.pdf} target="_blank" rel="noreferrer">Open the paper in a new tab.</a>
            </div>
          </object>
        </div>
      </section>

      <section class="mt-24" aria-labelledby="source-heading">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <h2 id="source-heading" class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76">
            LaTeX source
          </h2>
          <div class="hidden h-px flex-1 bg-black/10 dark:bg-white/12 sm:block"></div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              data-copy-latex
              class="inline-flex h-11 items-center gap-2 border border-black bg-black px-4 text-sm font-semibold text-white transition-colors hover:bg-[#242424] disabled:cursor-wait disabled:opacity-70 dark:border-white dark:bg-white dark:text-black dark:hover:bg-[#d9d9d9]"
            >
              <Copy className="copy-icon size-4" aria-hidden="true" />
              <Check className="copied-icon hidden size-4" aria-hidden="true" />
              <span data-copy-label aria-live="polite">Copy source</span>
            </button>
            <a
              href={data.source}
              download={`${downloadStem}.tex`}
              class="inline-flex h-11 items-center gap-2 border border-black/12 bg-white/60 px-4 text-sm font-semibold text-black transition-colors hover:border-black/25 hover:bg-white dark:border-white/14 dark:bg-white/6 dark:text-white dark:hover:border-white/28 dark:hover:bg-white/11"
            >
              <Download className="size-4" aria-hidden="true" />
              Download
            </a>
          </div>
        </div>
        <div id="latex-source" class="latex-source rounded-lg border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.25)]">
          <Code code={latexSource} lang="latex" theme="github-dark" />
        </div>
      </section>
    </div>
  </article>
</ResearchLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-latex]");
  const sourceCode = document.querySelector<HTMLElement>("#latex-source code");
  const copyLabel = copyButton?.querySelector<HTMLElement>("[data-copy-label]");
  const copyIcon = copyButton?.querySelector<HTMLElement>(".copy-icon");
  const copiedIcon = copyButton?.querySelector<HTMLElement>(".copied-icon");

  const copyWithFallback = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    const copied = document.execCommand("copy");
    textarea.remove();

    if (!copied) throw new Error("The browser rejected the copy command.");
  };

  copyButton?.addEventListener("click", async () => {
    if (!sourceCode || !copyLabel) return;

    copyButton.disabled = true;
    try {
      await copyWithFallback(sourceCode.textContent ?? "");
      copyLabel.textContent = "Copied";
      copyIcon?.classList.add("hidden");
      copiedIcon?.classList.remove("hidden");
    } catch {
      copyLabel.textContent = "Copy failed";
    }

    window.setTimeout(() => {
      copyButton.disabled = false;
      copyLabel.textContent = "Copy source";
      copyIcon?.classList.remove("hidden");
      copiedIcon?.classList.add("hidden");
    }, 1800);
  });
</script>
