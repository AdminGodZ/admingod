---
import { ShieldAlert } from "lucide-react";
import ResearchCard from "@/components/research/research-card.astro";
import ResearchLayout from "@/layouts/research-layout.astro";
import { getResearch } from "@/lib/research";

const entries = await getResearch();
---

<ResearchLayout
  title="Math research - AdminGod"
  description="AI-assisted investigations of mathematical conjectures and open problems, with papers, LaTeX source, and explicit verification status."
>
  <section class="relative z-[1] overflow-hidden px-5 pt-20 pb-20 sm:px-8 sm:pt-28 sm:pb-24 lg:px-12">
    <div class="pointer-events-none absolute top-1/2 right-[4vw] hidden -translate-y-1/2 select-none text-[21rem] font-black leading-none tracking-[-0.12em] text-black/[0.025] dark:text-white/[0.035] lg:block" aria-hidden="true">
      Σ
    </div>

    <div class="relative mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <h1 class="text-[clamp(3.8rem,9vw,7.8rem)] font-black leading-[0.86] tracking-[-0.055em] text-black dark:text-white">
          Math research
        </h1>
        <p class="mt-8 max-w-3xl text-lg leading-8 text-black/58 dark:text-white/58 sm:text-xl sm:leading-9">
          I use AI to test proof ideas around open problems, then publish the paper and its complete LaTeX source. Each entry says what the manuscript claims and how far that claim has been checked.
        </p>

        <aside class="mt-10 flex max-w-3xl gap-4 border-t border-black/10 pt-6 text-black/52 dark:border-white/10 dark:text-white/52">
          <ShieldAlert className="mt-0.5 size-4 shrink-0 text-black/72 dark:text-white/72" aria-hidden="true" />
          <p class="text-sm leading-6">
            A working paper is not an established result. A candidate solution names the manuscript's claim, not a solved problem.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="relative z-[1] px-5 pb-28 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 flex items-center gap-5">
        <h2 class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76">
          Research log
        </h2>
        <div class="h-px flex-1 bg-black/10 dark:bg-white/12"></div>
        <p class="shrink-0 text-sm font-medium text-black/42 dark:text-white/42">
          {entries.length.toString().padStart(2, "0")} {entries.length === 1 ? "paper" : "papers"}
        </p>
      </div>

      {
        entries.length > 0 ? (
          <div class="grid gap-5 lg:grid-cols-2">
            {entries.map((entry) => <ResearchCard entry={entry} />)}
          </div>
        ) : (
          <div class="border-y border-dashed border-black/16 py-10 text-black/58 dark:border-white/16 dark:text-white/58">
            The first paper is still being prepared for release.
          </div>
        )
      }
    </div>
  </section>
</ResearchLayout>
