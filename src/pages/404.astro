---
import Layout from "@/layouts/layout.astro";
---

<Layout
  title="404: This page could not be found."
  description="This page could not be found."
  noIndex
>
  <main class="not-found">
    <div>
      <h1>404</h1>
      <div>
        <h2>This page could not be found.</h2>
      </div>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    align-items: center;
    background: #fff;
    color: #000;
    display: flex;
    flex-direction: column;
    font-family:
      system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif,
      "Apple Color Emoji", "Segoe UI Emoji";
    height: 100vh;
    justify-content: center;
    text-align: center;
  }

  .not-found > div {
    display: block;
  }

  h1 {
    border-right: 1px solid rgb(0 0 0 / 30%);
    display: inline-block;
    font-size: 24px;
    font-weight: 500;
    line-height: 49px;
    margin: 0 20px 0 0;
    padding: 0 23px 0 0;
    vertical-align: top;
  }

  .not-found > div > div {
    display: inline-block;
  }

  h2 {
    font-size: 14px;
    font-weight: 400;
    line-height: 49px;
    margin: 0;
  }

  :global(html.dark) .not-found {
    background: #000;
    color: #fff;
  }

  :global(html.dark) h1 {
    border-right-color: rgb(255 255 255 / 30%);
  }
</style>
