---
import { ArrowLeft, Mail, Send } from "lucide-react";
import VoidParticleField from "@/components/portfolio/void-particle-field.astro";
import Layout from "@/layouts/layout.astro";

const contactEmail = "tim.held@pm.me";
---

<Layout
  title="Contact - AdminGod"
  description="Send a message to AdminGod about software, self-hosting, or a potential project."
>
  <main class="contact-page">
    <div class="contact-backdrop portfolio-void-bg" aria-hidden="true"></div>
    <div class="contact-particles" aria-hidden="true">
      <VoidParticleField class="h-full w-full" />
    </div>

    <div class="contact-frame">
      <a href="/" class="back-link">
        <ArrowLeft size={17} strokeWidth={2} aria-hidden="true" />
        Back home
      </a>

      <div class="contact-card">
        <section class="contact-intro">
          <div class="intro-content">
            <p class="contact-kicker">
              <span aria-hidden="true"></span>
              Get in touch
            </p>

            <h1>Let’s build<br />something.</h1>
            <p class="intro-copy">
              Have a project, an idea, or just want to talk about software? I’d
              like to hear from you.
            </p>
          </div>

          <div class="intro-footer">
            <p class="email-label">Direct email</p>
            <a class="email-link" href={`mailto:${contactEmail}`}>
              <span class="email-icon">
                <Mail size={17} strokeWidth={2} aria-hidden="true" />
              </span>
              {contactEmail}
            </a>
          </div>
        </section>

        <section class="contact-form-panel" aria-labelledby="contact-form-heading">
          <div class="form-heading">
            <h2 id="contact-form-heading">Send a message</h2>
            <span>A few details are all I need.</span>
          </div>

          <form
            id="contact-form"
            action={`mailto:${contactEmail}`}
            method="post"
            enctype="text/plain"
            novalidate
          >
            <div class="field-row">
              <label>
                <span class="field-label">Name</span>
                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  autocomplete="name"
                  maxlength="80"
                  required
                  aria-describedby="name-error"
                  placeholder="Your name"
                />
                <small id="name-error" class="field-error" aria-live="polite"></small>
              </label>

              <label>
                <span class="field-label">Email</span>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  autocomplete="email"
                  maxlength="160"
                  required
                  aria-describedby="email-error"
                  placeholder="you@example.com"
                />
                <small id="email-error" class="field-error" aria-live="polite"></small>
              </label>
            </div>

            <label>
              <span class="field-label">Subject</span>
              <input
                id="contact-subject"
                type="text"
                name="subject"
                maxlength="120"
                required
                aria-describedby="subject-error"
                placeholder="What would you like to discuss?"
              />
              <small id="subject-error" class="field-error" aria-live="polite"></small>
            </label>

            <label>
              <span class="field-label">Message</span>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                maxlength="4000"
                required
                aria-describedby="message-error"
                placeholder="Tell me about your idea..."
              ></textarea>
              <small id="message-error" class="field-error" aria-live="polite"></small>
            </label>

            <button type="submit">
              Send message
              <Send size={17} strokeWidth={2} aria-hidden="true" />
            </button>

            <p id="contact-status" class="form-note" aria-live="polite">
              This opens your email app with the message ready to send.
            </p>
          </form>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");
  const fields = Array.from(
    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "input[required], textarea[required]",
    ) ?? [],
  );

  const messages: Record<string, string> = {
    name: "Please enter your name.",
    email: "Please enter your email address.",
    subject: "Please add a subject.",
    message: "Please write a message.",
  };

  const getFieldError = (
    field: HTMLInputElement | HTMLTextAreaElement,
  ) => {
    if (!field.value.trim()) {
      return messages[field.name] ?? "Please complete this field.";
    }

    if (field.validity.typeMismatch) {
      return "Please enter a valid email address.";
    }

    return field.validity.valid ? "" : "Please check this field.";
  };

  const renderFieldError = (
    field: HTMLInputElement | HTMLTextAreaElement,
  ) => {
    const message = getFieldError(field);
    const error = document.querySelector<HTMLElement>(
      `#${field.name}-error`,
    );

    field.setAttribute("aria-invalid", String(Boolean(message)));

    if (error) {
      error.textContent = message;
    }

    return !message;
  };

  fields.forEach((field) => {
    field.addEventListener("input", () => {
      if (field.getAttribute("aria-invalid") === "true") {
        renderFieldError(field);
      }
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const firstInvalidField = fields.find((field) => !renderFieldError(field));

    if (firstInvalidField) {
      if (status) {
        status.dataset.state = "error";
        status.textContent = "Please check the highlighted field.";
      }

      firstInvalidField.focus();
      return;
    }

    const formData = new FormData(form);
    const name = String(formData.get("name") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    const subject = String(formData.get("subject") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();

    const emailSubject = `Portfolio contact: ${subject}`;
    const emailBody = [
      "Hi Tim,",
      "",
      message,
      "",
      "—",
      `Name: ${name}`,
      `Reply email: ${email}`,
    ].join("\n");

    if (status) {
      delete status.dataset.state;
      status.textContent = "Opening your email app…";
    }

    window.location.href = `${form.getAttribute("action")}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
  });
</script>

<style>
  .contact-page {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    background: #fafafa;
    color: #101010;
    isolation: isolate;
  }

  .contact-backdrop,
  .contact-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-backdrop {
    z-index: -3;
  }

  .contact-particles {
    z-index: -1;
    top: auto;
    height: 58%;
    opacity: 0.27;
    mask-image: linear-gradient(to bottom, transparent, #000 42%, #000);
  }

  .contact-frame {
    width: min(1120px, calc(100% - 48px));
    margin: auto;
    padding: 30px 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 18px 2px;
    color: rgba(16, 16, 16, 0.58);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .back-link:hover {
    color: #101010;
    transform: translateX(-2px);
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(310px, 0.86fr) minmax(0, 1.14fr);
    overflow: hidden;
    border: 1px solid rgba(16, 16, 16, 0.12);
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 34px 90px rgba(0, 0, 0, 0.13),
      0 4px 18px rgba(0, 0, 0, 0.045);
  }

  .contact-intro {
    position: relative;
    display: flex;
    min-height: 610px;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(38px, 4vw, 58px);
    background: #0b0b0b;
    color: #fff;
    isolation: isolate;
  }

  .contact-intro::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    mask-image: linear-gradient(145deg, #000, transparent 76%);
  }

  .contact-intro::after {
    position: absolute;
    z-index: -1;
    right: -35%;
    bottom: -30%;
    width: 95%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    box-shadow:
      0 0 0 42px rgba(255, 255, 255, 0.025),
      0 0 90px rgba(255, 255, 255, 0.07);
    filter: blur(1px);
    content: "";
  }

  .contact-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .contact-kicker span {
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.32);
  }

  .contact-intro h1 {
    margin: 82px 0 0;
    font-size: clamp(3.6rem, 5.3vw, 5.25rem);
    font-weight: 850;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }

  .intro-copy {
    max-width: 370px;
    margin: 30px 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    line-height: 1.72;
  }

  .intro-footer {
    position: relative;
    z-index: 1;
    padding-top: 44px;
  }

  .email-label {
    margin: 0 0 11px;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .email-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.075);
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .email-link:hover .email-icon {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.13);
  }

  .contact-form-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(38px, 4.2vw, 60px);
    background: #fff;
  }

  .form-heading h2 {
    margin: 0;
    color: #0c0c0c;
    font-size: clamp(2rem, 2.8vw, 2.7rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .form-heading > span {
    display: block;
    margin-top: 11px;
    color: rgba(16, 16, 16, 0.5);
    font-size: 0.9rem;
  }

  form {
    display: grid;
    gap: 17px;
    margin-top: 32px;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  label {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .field-label {
    color: rgba(16, 16, 16, 0.72);
    font-size: 0.78rem;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid rgba(16, 16, 16, 0.12);
    border-radius: 9px;
    outline: none;
    background: #f7f7f7;
    color: #101010;
    font: inherit;
    transition:
      border-color 170ms ease,
      background 170ms ease,
      box-shadow 170ms ease;
  }

  input {
    height: 48px;
    padding: 0 14px;
  }

  textarea {
    min-height: 134px;
    resize: vertical;
    padding: 13px 14px;
    line-height: 1.55;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(16, 16, 16, 0.3);
  }

  input:focus,
  textarea:focus {
    border-color: rgba(16, 16, 16, 0.12);
    background: #fff;
    box-shadow: none;
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"],
  input[aria-invalid="true"]:focus,
  textarea[aria-invalid="true"]:focus {
    border-color: rgba(174, 35, 35, 0.48);
    background: #fffafa;
    box-shadow: 0 0 0 3px rgba(174, 35, 35, 0.055);
  }

  .field-error {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: -1px 2px 0;
    color: #9f2525;
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .field-error:empty {
    display: none;
  }

  .field-error:not(:empty)::before {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
    content: "";
  }

  button {
    display: inline-flex;
    width: 100%;
    height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 2px;
    border: 1px solid #0c0c0c;
    border-radius: 9px;
    background: #0c0c0c;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  button:hover {
    background: #242424;
  }

  .form-note {
    min-height: 18px;
    margin: -2px 0 0;
    color: rgba(16, 16, 16, 0.4);
    font-size: 0.7rem;
    line-height: 1.5;
    text-align: center;
  }

  .form-note[data-state="error"] {
    color: #9f2525;
    font-weight: 600;
  }

  :global(html.dark) .contact-page {
    background: #000;
    color: #f5f5f5;
  }

  :global(html.dark) .contact-particles {
    opacity: 0.2;
  }

  :global(html.dark) .back-link {
    color: rgba(245, 245, 245, 0.58);
  }

  :global(html.dark) .back-link:hover {
    color: #fff;
  }

  :global(html.dark) .contact-card {
    border-color: rgba(255, 255, 255, 0.12);
    background: #0a0a0a;
    box-shadow:
      0 34px 90px rgba(0, 0, 0, 0.72),
      0 4px 18px rgba(0, 0, 0, 0.5);
  }

  :global(html.dark) .contact-intro {
    background: #050505;
  }

  :global(html.dark) .contact-form-panel {
    background: #0a0a0a;
  }

  :global(html.dark) .form-heading h2 {
    color: #f5f5f5;
  }

  :global(html.dark) .form-heading > span {
    color: rgba(245, 245, 245, 0.5);
  }

  :global(html.dark) .field-label {
    color: rgba(245, 245, 245, 0.72);
  }

  :global(html.dark) input,
  :global(html.dark) textarea {
    border-color: rgba(255, 255, 255, 0.12);
    background: #111;
    color: #f5f5f5;
  }

  :global(html.dark) input::placeholder,
  :global(html.dark) textarea::placeholder {
    color: rgba(245, 245, 245, 0.3);
  }

  :global(html.dark) input:focus,
  :global(html.dark) textarea:focus {
    border-color: rgba(255, 255, 255, 0.12);
    background: #171717;
  }

  :global(html.dark) input[aria-invalid="true"],
  :global(html.dark) textarea[aria-invalid="true"],
  :global(html.dark) input[aria-invalid="true"]:focus,
  :global(html.dark) textarea[aria-invalid="true"]:focus {
    border-color: rgba(248, 113, 113, 0.52);
    background: #1c0d0d;
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.08);
  }

  :global(html.dark) .field-error,
  :global(html.dark) .form-note[data-state="error"] {
    color: #f87171;
  }

  :global(html.dark) button {
    border-color: #fff;
    background: #fff;
    color: #0a0a0a;
  }

  :global(html.dark) button:hover {
    background: #d9d9d9;
  }

  :global(html.dark) .form-note {
    color: rgba(245, 245, 245, 0.42);
  }

  @media (max-width: 820px) {
    .contact-page {
      display: block;
      overflow: visible;
    }

    .contact-frame {
      width: min(680px, calc(100% - 32px));
      padding: 24px 0 32px;
    }

    .contact-card {
      grid-template-columns: 1fr;
    }

    .contact-intro {
      min-height: 420px;
    }

    .contact-intro h1 {
      margin-top: 52px;
      font-size: clamp(3.25rem, 14vw, 5rem);
    }

    .intro-copy {
      max-width: 440px;
    }
  }

  @media (max-width: 540px) {
    .contact-frame {
      width: min(100% - 24px, 680px);
      padding-top: 20px;
    }

    .contact-card {
      border-radius: 17px;
    }

    .contact-intro,
    .contact-form-panel {
      padding: 30px 24px;
    }

    .contact-intro {
      min-height: 380px;
    }

    .contact-intro h1 {
      margin-top: 42px;
      font-size: clamp(3.1rem, 17vw, 4.5rem);
    }

    .intro-copy {
      margin-top: 24px;
      font-size: 0.94rem;
    }

    .field-row {
      grid-template-columns: 1fr;
      gap: 17px;
    }

    form {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .email-icon,
    input,
    textarea,
    button {
      transition: none;
    }
  }
</style>
