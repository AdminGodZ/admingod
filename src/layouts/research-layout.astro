---
import { ArrowLeft, ArrowUpRight } from "lucide-react";
import LivingStarfield from "@/components/portfolio/living-starfield.astro";
import ScrollSidebar from "@/components/portfolio/scroll-sidebar";
import Layout from "@/layouts/layout.astro";
import "katex/dist/katex.min.css";
import "@/styles/research.css";

interface Props {
  title: string;
  description: string;
  pageType?: "website" | "article";
}

const { title, description, pageType = "website" } = Astro.props;
---

<Layout title={title} description={description} pageType={pageType}>
  <main class="research-shell portfolio-page relative min-h-screen overflow-hidden text-foreground">
    <LivingStarfield />
    <ScrollSidebar client:load />

    <header class="relative z-10 px-5 sm:px-8 lg:px-12">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 border-b border-black/10 dark:border-white/10">
        <a
          href="/"
          class="group inline-flex items-center gap-2 text-sm font-semibold text-black/64 transition-colors hover:text-black dark:text-white/64 dark:hover:text-white"
        >
          <ArrowLeft className="size-4 transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true" />
          Portfolio
        </a>

        <a
          href="/research"
          class="text-sm font-black tracking-[-0.02em] text-black dark:text-white"
        >
          AdminGod <span class="font-medium text-black/32 dark:text-white/32">/ Research</span>
        </a>
      </div>
    </header>

    <slot />

    <footer class="relative z-10 px-5 pb-10 text-black dark:text-white sm:px-8 lg:px-12">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 border-t border-black/10 pt-8 dark:border-white/10 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-bold">AdminGod</p>
          <p class="mt-1 text-sm text-black/48 dark:text-white/48">
            Math notes, working papers, and source files.
          </p>
        </div>
        <a
          href="https://github.com/AdminGodZ/admingod"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-black/62 transition-colors hover:text-black dark:text-white/62 dark:hover:text-white"
        >
          Site source
          <ArrowUpRight className="size-4" aria-hidden="true" />
        </a>
      </div>
    </footer>
  </main>
</Layout>
