---
import { Moon, Sun } from "lucide-react";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = "AdminGod - Portfolio",
  description = "Portfolio of AdminGod, focused on practical full-stack engineering, automation, and polished web interfaces.",
  noIndex = false,
} = Astro.props;

const openGraphDescription =
  "Practical full-stack engineering, automation, and polished web interfaces.";
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/admingod_white_transparent.png" />
    <link rel="shortcut icon" href="/admingod_white_transparent.png" />
    <link rel="apple-touch-icon" href="/admingod_white_transparent.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={openGraphDescription} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={openGraphDescription} />
    <script is:inline>
      try {
        if (
          localStorage.getItem("admingod-color-inversion") === "true"
        ) {
          document.documentElement.classList.add("portfolio-inverted");
        }
      } catch {}
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <button
      type="button"
      data-color-inversion-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
      class="fixed right-4 bottom-4 z-[100] inline-flex size-12 items-center justify-center rounded-full border border-white/15 bg-black text-white shadow-[0_12px_32px_rgba(0,0,0,0.22)] transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_38px_rgba(0,0,0,0.28)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:right-6 sm:bottom-6"
    >
      <Moon className="theme-toggle-moon size-5" aria-hidden="true" />
      <Sun className="theme-toggle-sun size-5" aria-hidden="true" />
    </button>

    <script>
      const storageKey = "admingod-color-inversion";
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-color-inversion-toggle]",
      );

      const syncToggle = () => {
        if (!toggle) return;

        const inverted = root.classList.contains("portfolio-inverted");
        const label = inverted
          ? "Switch to light mode"
          : "Switch to dark mode";

        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("aria-pressed", String(inverted));
        toggle.title = label;
      };

      syncToggle();
      toggle?.addEventListener("click", () => {
        const inverted = root.classList.toggle("portfolio-inverted");

        try {
          localStorage.setItem(storageKey, String(inverted));
        } catch {}

        syncToggle();
      });
    </script>
  </body>
</html>
