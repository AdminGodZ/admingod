---
import { Moon, Sun } from "lucide-react";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  pageType?: "website" | "article";
}

const {
  title = "AdminGod - Portfolio",
  description = "Portfolio of AdminGod, focused on practical full-stack engineering, automation, and polished web interfaces.",
  noIndex = false,
  pageType = "website",
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("admingod-theme");
        const legacyDarkMode =
          localStorage.getItem("admingod-color-inversion") === "true";
        const theme = savedTheme ?? (legacyDarkMode ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
      } catch {}
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <button
      type="button"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
      class="fixed right-4 bottom-4 z-[100] inline-flex size-12 items-center justify-center rounded-full border border-black bg-black text-white shadow-[0_12px_32px_rgba(0,0,0,0.22)] transition-shadow duration-300 hover:shadow-[0_16px_38px_rgba(0,0,0,0.28)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black dark:border-white dark:bg-white dark:text-black dark:shadow-[0_12px_32px_rgba(0,0,0,0.55)] dark:hover:shadow-[0_16px_38px_rgba(0,0,0,0.68)] dark:focus-visible:outline-white sm:right-6 sm:bottom-6"
    >
      <Moon className="theme-toggle-moon size-5" aria-hidden="true" />
      <Sun className="theme-toggle-sun size-5" aria-hidden="true" />
    </button>

    <script>
      const storageKey = "admingod-theme";
      const legacyStorageKey = "admingod-color-inversion";
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );

      const syncToggle = () => {
        if (!toggle) return;

        const dark = root.classList.contains("dark");
        const label = dark
          ? "Switch to light mode"
          : "Switch to dark mode";

        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("aria-pressed", String(dark));
        toggle.title = label;
      };

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      const applyTheme = (dark: boolean) => {
        root.classList.toggle("dark", dark);

        try {
          localStorage.setItem(storageKey, dark ? "dark" : "light");
          localStorage.removeItem(legacyStorageKey);
        } catch {}

        syncToggle();
      };

      syncToggle();
      toggle?.addEventListener("click", (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const dark = !root.classList.contains("dark");

        if (
          typeof document.startViewTransition !== "function" ||
          reducedMotion.matches
        ) {
          applyTheme(dark);
          return;
        }

        // The new theme spreads out of the toggle as a growing circle.
        const rect = button.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const radius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y),
        );

        root.classList.add("theme-transition");
        const transition = document.startViewTransition(() =>
          applyTheme(dark),
        );

        transition.ready
          .then(() => {
            root.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${radius}px at ${x}px ${y}px)`,
                ],
              },
              {
                duration: 720,
                easing: "cubic-bezier(0.76, 0, 0.24, 1)",
                pseudoElement: "::view-transition-new(root)",
              },
            );
          })
          .catch(() => {});
        transition.finished.finally(() => {
          root.classList.remove("theme-transition");
        });
      });
    </script>
  </body>
</html>
