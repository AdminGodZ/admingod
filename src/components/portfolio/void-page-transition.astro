---
// Cross-document view transition between pages: the old page collapses into
// the void and the new one surfaces from it while a burst of particles
// scatters out of the center. Pure CSS; browsers without cross-document view
// transitions navigate normally.
const createRandom = (seed: number) => {
  let value = seed;

  return () => {
    value = (value + 0x6d2b79f5) | 0;
    let result = Math.imul(value ^ (value >>> 15), 1 | value);
    result ^= result + Math.imul(result ^ (result >>> 7), 61 | result);
    return ((result ^ (result >>> 14)) >>> 0) / 4294967296;
  };
};

const random = createRandom(0x3c6ef372);

const particles = Array.from({ length: 64 }, (_, index) => {
  const angle = random() * Math.PI * 2;
  const distance = 16 + random() ** 0.6 * 46;
  const start = random() * 4;

  return {
    startX: Math.cos(angle) * start,
    startY: Math.sin(angle) * start,
    endX: Math.cos(angle) * distance,
    endY: Math.sin(angle) * distance,
    rotation: (angle * 180) / Math.PI,
    size: 0.8 + random() * 2.2,
    alpha: 0.28 + random() * 0.6,
    duration: 0.48 + random() * 0.3,
    delay: 0.04 + random() * 0.1,
    streak: index % 5 === 0,
  };
});
---

<div class="void-arrival" aria-hidden="true">
  <div class="void-arrival__ring"></div>
  {
    particles.map((particle) => (
      <span
        class:list={[
          "void-arrival__particle",
          { "void-arrival__particle--streak": particle.streak },
        ]}
        style={`--start-x:${particle.startX.toFixed(2)}vmin;--start-y:${particle.startY.toFixed(2)}vmin;--end-x:${particle.endX.toFixed(2)}vmin;--end-y:${particle.endY.toFixed(2)}vmin;--rotation:${particle.rotation.toFixed(1)}deg;--size:${particle.size.toFixed(2)}px;--alpha:${particle.alpha.toFixed(2)};--duration:${particle.duration.toFixed(2)}s;--delay:${particle.delay.toFixed(2)}s;`}
      />
    ))
  }
</div>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
      types: void;
    }
  }

  html:active-view-transition-type(void)::view-transition {
    background-color: var(--background);
  }

  html:active-view-transition-type(void)::view-transition-old(root) {
    animation: void-page-out 380ms cubic-bezier(0.7, 0, 0.84, 0) both;
  }

  html:active-view-transition-type(void)::view-transition-new(root) {
    animation: void-page-in 760ms cubic-bezier(0.16, 1, 0.3, 1) 180ms both;
  }

  /* Keep the theme toggle anchored while the pages swap around it. */
  html:active-view-transition-type(void) [data-theme-toggle] {
    view-transition-name: theme-toggle;
  }

  .void-arrival {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    pointer-events: none;
  }

  html:active-view-transition-type(void) .void-arrival {
    display: block;
    view-transition-name: void-arrival;
  }

  html:active-view-transition-type(void)::view-transition-old(void-arrival),
  html:active-view-transition-type(void)::view-transition-new(void-arrival) {
    animation: none;
  }

  .void-arrival__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12vmin;
    height: 12vmin;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgb(0 0 0 / 0%) 38%,
      rgb(0 0 0 / 22%) 58%,
      rgb(0 0 0 / 0%) 72%
    );
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
    animation: void-arrival-ring 720ms cubic-bezier(0.16, 1, 0.3, 1) 60ms
      both;
  }

  .void-arrival__particle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--size);
    height: var(--size);
    border-radius: 999px;
    background: rgb(14 14 14);
    box-shadow: 0 0 6px rgb(0 0 0 / 30%);
    opacity: 0;
    animation: void-arrival-particle var(--duration)
      cubic-bezier(0.2, 0.7, 0.3, 1) var(--delay) both;
  }

  .void-arrival__particle--streak {
    width: calc(var(--size) * 4);
    height: max(1px, calc(var(--size) * 0.5));
  }

  html.dark .void-arrival__ring {
    background: radial-gradient(
      circle,
      rgb(255 255 255 / 0%) 38%,
      rgb(255 255 255 / 20%) 58%,
      rgb(255 255 255 / 0%) 72%
    );
  }

  html.dark .void-arrival__particle {
    background: rgb(232 232 232);
    box-shadow: 0 0 8px rgb(255 255 255 / 28%);
  }

  @keyframes void-page-out {
    to {
      opacity: 0;
      filter: blur(8px);
      transform: scale(0.92);
    }
  }

  @keyframes void-page-in {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: scale(1.05);
    }
  }

  @keyframes void-arrival-ring {
    25% {
      opacity: 1;
    }

    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(14);
    }
  }

  @keyframes void-arrival-particle {
    from {
      opacity: 0;
      transform: translate(var(--start-x), var(--start-y))
        rotate(var(--rotation)) scale(0.4);
    }

    18% {
      opacity: var(--alpha);
    }

    to {
      opacity: 0;
      transform: translate(var(--end-x), var(--end-y)) rotate(var(--rotation))
        scale(1.1);
    }
  }
</style>
