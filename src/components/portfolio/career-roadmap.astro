---
// The career roadmap pins to the screen while the page scrolls through it.
// Scrolling moves through the chapters on the rail one at a time, then opens
// the fork of paths that could come next. The motion lives in
// career-roadmap-motion.ts; without it the first chapter shows on its own.

import {
  BriefcaseBusiness,
  Code2,
  Crosshair,
  GraduationCap,
  House,
  MapPin,
  School,
  ShieldCheck,
} from "lucide-react";

const milestones = [
  {
    stop: "Germany",
    label: "Before Switzerland",
    title: "Growing up in Germany",
    description:
      "I spent my early years and attended school in Germany before moving to Switzerland.",
    icon: House,
  },
  {
    stop: "Switzerland",
    label: "Arrival in Switzerland",
    title: "Germany → Switzerland",
    description:
      "Moved to Switzerland and joined lower secondary school at level B in year 2.",
    icon: MapPin,
  },
  {
    stop: "Level B",
    label: "Around 1.5 years",
    title: "Finding my footing at level B",
    description:
      "Stayed at lower secondary level B for around one and a half years, including one class change back to year 1.",
    icon: School,
  },
  {
    stop: "Level A",
    label: "Level change",
    title: "Level B, year 1 → Level A, year 2",
    description:
      "Changed both class and performance level, moving directly into lower secondary level A in year 2.",
    icon: School,
  },
  {
    stop: "Graduated",
    label: "Compulsory schooling completed",
    title: "Lower secondary level A, year 3",
    description:
      "Continued at level A through year 3 and completed compulsory secondary school.",
    icon: GraduationCap,
  },
  {
    stop: "Apprenticeship",
    label: "Year 4, Semester 7/8",
    title: "Software engineer",
    description:
      "I am now in Year 4, Semester 7/8 of my apprenticeship, building experience in application development.",
    icon: BriefcaseBusiness,
    current: true,
  },
];

const academicSteps = [
  {
    title: "University entrance exam",
    detail: "1 year · Vocational-to-university bridge",
  },
  { title: "University" },
  { title: "Bachelor’s degree" },
  { title: "Master’s degree" },
  { title: "Possible doctorate" },
];

// Scroll length, in chapters: one per milestone plus the fork at the end.
const futureUnits = 2.2;
const scrollUnits = milestones.length + futureUnits;

const pad = (value: number) => String(value).padStart(2, "0");
---

<section
  id="roadmap"
  data-roadmap
  data-roadmap-future-units={futureUnits}
  aria-labelledby="roadmap-heading"
  class="roadmap relative z-[1]"
  style={`--roadmap-units: ${scrollUnits}`}
>
  <div class="roadmap-stage" data-roadmap-stage>
    <div class="roadmap-frame" data-roadmap-frame>
      <div class="flex items-center gap-5">
        <h2
          id="roadmap-heading"
          class="shrink-0 text-lg font-semibold text-black/76 dark:text-white/76"
        >
          Career roadmap
        </h2>
        <div class="h-px flex-1 bg-black/10 dark:bg-white/12"></div>
        <p
          class="roadmap-counter shrink-0 text-sm font-semibold text-black/50 dark:text-white/50"
          aria-hidden="true"
        >
          <span data-roadmap-counter>01 / {pad(milestones.length)}</span>
        </p>
      </div>

      <nav class="roadmap-rail" aria-label="Roadmap chapters">
        <div class="roadmap-rail-track" aria-hidden="true">
          <span class="roadmap-rail-fill" data-roadmap-fill></span>
        </div>
        <ol class="roadmap-stops">
          {
            milestones.map((milestone, index) => (
              <li>
                <button
                  type="button"
                  class="roadmap-stop"
                  data-roadmap-stop={index}
                  aria-label={`Show chapter ${index + 1}: ${milestone.title}`}
                >
                  <span class="roadmap-stop-number">{pad(index + 1)}</span>
                  <span class="roadmap-stop-dot" />
                  <span class="roadmap-stop-label">{milestone.stop}</span>
                </button>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              class="roadmap-stop roadmap-stop-next"
              data-roadmap-stop={milestones.length}
              aria-label="Show where the path could lead"
            >
              <span class="roadmap-stop-number">Next</span>
              <span class="roadmap-stop-dot">?</span>
              <span class="roadmap-stop-label">The fork</span>
            </button>
          </li>
        </ol>
      </nav>

      <div class="roadmap-scenes">
        <ol class="roadmap-chapters" aria-label="Career history">
          {
            milestones.map((milestone, index) => {
              const Icon = milestone.icon;

              return (
                <li class="roadmap-chapter" data-roadmap-chapter={index}>
                  <article
                    class:list={[
                      "roadmap-card",
                      milestone.current && "roadmap-card-current",
                    ]}
                  >
                    <span class="roadmap-card-mark" aria-hidden="true">
                      <Icon className="h-full w-full" strokeWidth={0.75} />
                    </span>
                    <span class="roadmap-card-numeral" aria-hidden="true">
                      {pad(index + 1)}
                    </span>
                    <div class="roadmap-card-body">
                      <div class="flex items-center gap-3">
                        <span class="roadmap-card-icon">
                          <Icon className="h-5 w-5" aria-hidden="true" />
                        </span>
                        <p class="roadmap-card-label">{milestone.label}</p>
                        {milestone.current && (
                          <span class="roadmap-card-now">
                            <span class="roadmap-card-now-dot" />
                            Current
                          </span>
                        )}
                      </div>
                      <h3 class="roadmap-card-title">{milestone.title}</h3>
                      <p class="roadmap-card-text">{milestone.description}</p>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ol>

        <div class="roadmap-future" data-roadmap-future>
          <header class="roadmap-future-header" data-roadmap-reveal="0">
            <p class="roadmap-card-label">The next chapter</p>
            <h3 class="mt-2 text-2xl font-black tracking-tight text-black sm:text-3xl dark:text-white">
              Where the path could lead
            </h3>
            <p class="roadmap-future-intro">
              Two directions I am considering now, alongside the academic
              route I had planned before.
            </p>
          </header>

          <svg class="roadmap-fork" aria-hidden="true" data-roadmap-fork>
            <defs>
              <mask id="roadmap-fork-academic-mask" maskUnits="userSpaceOnUse">
                <path
                  class="roadmap-fork-mask"
                  data-roadmap-fork-path="academic"
                  data-roadmap-draw="0.08"
                  pathLength="1"
                />
              </mask>
            </defs>
            <path
              class="roadmap-fork-line"
              data-roadmap-fork-path="police"
              data-roadmap-draw="0.08"
              pathLength="1"
            />
            <path
              class="roadmap-fork-line"
              data-roadmap-fork-path="it"
              data-roadmap-draw="0.08"
              pathLength="1"
            />
            <path
              class="roadmap-fork-line roadmap-fork-dotted"
              data-roadmap-fork-path="academic"
              mask="url(#roadmap-fork-academic-mask)"
            />
          </svg>

          <div class="roadmap-paths">
            <div class="roadmap-path" data-roadmap-path="police">
              <article class="roadmap-path-card" data-roadmap-reveal="0.26">
                <span class="roadmap-path-icon">
                  <ShieldCheck className="h-5 w-5" aria-hidden="true" />
                </span>
                <p class="roadmap-card-label sm:mt-4">Possible path</p>
                <h4 class="roadmap-path-title">Join the cantonal police</h4>
                <p class="roadmap-path-text">
                  Pursue a role with the cantonal police in Zürich, St. Gallen
                  or Schaffhausen and build a career around responsibility and
                  public service.
                </p>
              </article>
              <span class="roadmap-path-link" data-roadmap-reveal="0.44"></span>
              <article
                class="roadmap-special-unit"
                data-roadmap-reveal="0.5"
                aria-labelledby="special-unit-heading"
              >
                <span class="roadmap-special-unit-icon" aria-hidden="true">
                  <Crosshair className="h-6 w-6" />
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-white/56">
                    Possible continuation
                  </p>
                  <h5
                    id="special-unit-heading"
                    class="mt-1 text-lg leading-tight font-bold"
                  >
                    Swiss police special unit
                  </h5>
                  <p class="roadmap-special-unit-text">
                    A later specialization I could pursue after gaining
                    operational experience in cantonal policing and meeting the
                    unit's selection requirements.
                  </p>
                </div>
              </article>
            </div>

            <div class="roadmap-path" data-roadmap-path="it">
              <article class="roadmap-path-card" data-roadmap-reveal="0.32">
                <span class="roadmap-path-icon">
                  <Code2 className="h-5 w-5" aria-hidden="true" />
                </span>
                <p class="roadmap-card-label sm:mt-4">Possible path</p>
                <h4 class="roadmap-path-title">Continue in IT</h4>
                <p class="roadmap-path-text">
                  Remain in application development, deepen my engineering
                  skills and keep growing through more demanding software
                  projects.
                </p>
              </article>
            </div>

            <article
              class="roadmap-path roadmap-path-academic"
              data-roadmap-path="academic"
              aria-labelledby="earlier-plan-heading"
            >
              <header
                class="roadmap-path-card roadmap-path-card-dotted"
                data-roadmap-reveal="0.38"
              >
                <span class="roadmap-path-icon roadmap-path-icon-dotted">
                  <GraduationCap className="h-5 w-5" aria-hidden="true" />
                </span>
                <p class="roadmap-card-label sm:mt-4">Earlier plan</p>
                <h4 id="earlier-plan-heading" class="roadmap-path-title">
                  The academic route
                </h4>
              </header>
              <ol class="roadmap-academic" aria-label="Earlier academic route">
                {
                  academicSteps.map((step, index) => (
                    <li
                      class="roadmap-academic-step"
                      data-roadmap-reveal={(0.5 + index * 0.06).toFixed(2)}
                    >
                      <p class="font-semibold text-black/76 dark:text-white/76">
                        {step.title}
                      </p>
                      {step.detail && (
                        <p class="roadmap-academic-detail">{step.detail}</p>
                      )}
                    </li>
                  ))
                }
              </ol>
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap {
    height: calc(100svh + var(--roadmap-units) * 58svh);
  }

  .roadmap-stage {
    position: sticky;
    top: 0;
    display: flex;
    height: 100svh;
    align-items: center;
    overflow: hidden;
  }

  /* A soft spotlight behind the stage. */
  .roadmap-stage::before {
    position: absolute;
    inset: 10% 8% 0;
    z-index: -1;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgb(37 99 235 / 7%),
      transparent 62%
    );
    content: "";
    pointer-events: none;
  }

  .roadmap-frame {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    transform: scale(var(--roadmap-fit, 1));
    transform-origin: 50% 50%;
  }

  .roadmap-counter {
    min-width: 4.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* The rail */
  .roadmap-rail {
    --stop-number: 1.25rem;
    --stop-dot: 0.75rem;

    position: relative;
    margin-top: 1.75rem;
  }

  .roadmap-rail-track {
    position: absolute;
    top: calc(var(--stop-number) + 0.5rem + var(--stop-dot) / 2);
    right: calc(100% / 14);
    left: calc(100% / 14);
    height: 1px;
    background: rgb(15 23 42 / 12%);
  }

  .roadmap-rail-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--roadmap-fill, 0%);
    background: linear-gradient(90deg, rgb(15 23 42 / 70%), #2563eb);
  }

  .roadmap-rail-fill::after {
    position: absolute;
    top: 50%;
    right: -3px;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #2563eb;
    box-shadow:
      0 0 0 4px rgb(37 99 235 / 16%),
      0 0 18px 4px rgb(37 99 235 / 45%);
    content: "";
    transform: translateY(-50%);
  }

  .roadmap-stops {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-stop {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    background: none;
    color: rgb(0 0 0 / 38%);
    cursor: pointer;
    font: inherit;
    transition: color 400ms ease;
  }

  .roadmap-stop-number {
    height: var(--stop-number);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: var(--stop-number);
    font-variant-numeric: tabular-nums;
  }

  .roadmap-stop-dot {
    display: flex;
    width: var(--stop-dot);
    height: var(--stop-dot);
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(0 0 0 / 22%);
    border-radius: 9999px;
    background: #fcfcfb;
    box-shadow: 0 0 0 4px #fcfcfb;
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease,
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .roadmap-stop-label {
    display: none;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .roadmap-stop-next .roadmap-stop-dot {
    width: 1.5rem;
    height: 1.5rem;
    margin-block: calc((var(--stop-dot) - 1.5rem) / 2);
    font-size: 0.7rem;
    font-weight: 800;
    color: rgb(0 0 0 / 45%);
  }

  .roadmap-stop.is-reached {
    color: rgb(0 0 0 / 62%);
  }

  .roadmap-stop.is-reached .roadmap-stop-dot {
    border-color: #0d0d0d;
    background: #0d0d0d;
    color: #fff;
  }

  .roadmap-stop.is-active {
    color: #0d0d0d;
  }

  .roadmap-stop.is-active .roadmap-stop-dot {
    border-color: #2563eb;
    background: #2563eb;
    box-shadow:
      0 0 0 4px #fcfcfb,
      0 0 0 7px rgb(37 99 235 / 20%),
      0 0 22px 6px rgb(37 99 235 / 35%);
    transform: scale(1.25);
  }

  .roadmap-stop:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 4px;
    border-radius: 0.375rem;
  }

  /* Scenes share one grid cell, so the stage is as tall as the tallest. */
  .roadmap-scenes {
    display: grid;
    margin-top: 1.75rem;
  }

  /* The chapter card fills the stage, which is sized for the fork. */
  .roadmap-chapters {
    display: grid;
    grid-area: 1 / 1;
    align-self: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-chapter {
    display: grid;
    grid-area: 1 / 1;
    opacity: var(--chapter-opacity, 0);
    filter: blur(var(--chapter-blur, 0px));
    transform: translate3d(var(--chapter-x, 0px), 0, 0)
      scale(var(--chapter-scale, 1));
    will-change: transform, opacity, filter;
  }

  .roadmap-chapter:first-child {
    --chapter-opacity: 1;
  }

  .roadmap-card {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.25rem;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 1rem;
    background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      0 1px 2px rgb(15 23 42 / 6%),
      0 28px 70px -24px rgb(15 23 42 / 22%);
    padding: 1.5rem;
    color: #0d0d0d;
  }

  /* A faint blue light in the card's corner. */
  .roadmap-card::before {
    position: absolute;
    inset: -40% -20% auto auto;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(37 99 235 / 9%), transparent 65%);
    content: "";
    pointer-events: none;
  }

  /* The chapter's icon, drawn large and faint in the corner. */
  .roadmap-card-mark {
    position: absolute;
    top: 50%;
    right: -14%;
    width: 78%;
    aspect-ratio: 1;
    translate: 0 -62%;
    color: rgb(0 0 0 / 5%);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .roadmap-card-numeral {
    position: relative;
    background: linear-gradient(180deg, rgb(0 0 0 / 82%), rgb(0 0 0 / 6%));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: clamp(6.5rem, 30vw, 9.5rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.82;
    font-variant-numeric: tabular-nums;
  }

  .roadmap-card-body {
    position: relative;
    min-width: 0;
    align-self: center;
  }

  .roadmap-card-icon,
  .roadmap-path-icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 0.625rem;
    background: rgb(0 0 0 / 3%);
    color: rgb(0 0 0 / 72%);
  }

  .roadmap-card-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(0 0 0 / 55%);
  }

  .roadmap-card-title {
    margin-top: 1rem;
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .roadmap-card-text {
    max-width: 38rem;
    margin-top: 0.875rem;
    font-size: 1rem;
    line-height: 1.7;
    color: rgb(0 0 0 / 58%);
  }

  .roadmap-card-now {
    display: inline-flex;
    margin-left: auto;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 9999px;
    background: rgb(255 255 255 / 8%);
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgb(255 255 255 / 82%);
  }

  .roadmap-card-now-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #3b82f6;
    box-shadow: 0 0 0 0 rgb(59 130 246 / 60%);
    animation: roadmap-pulse 2.2s ease-out infinite;
  }

  @keyframes roadmap-pulse {
    to {
      box-shadow: 0 0 0 9px rgb(59 130 246 / 0%);
    }
  }

  .roadmap-card-current {
    border-color: rgb(255 255 255 / 10%);
    background:
      radial-gradient(
        ellipse at 85% 0%,
        rgb(37 99 235 / 32%),
        transparent 55%
      ),
      linear-gradient(180deg, #151515 0%, #0b0b0b 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      0 30px 80px -24px rgb(15 23 42 / 45%);
    color: #fff;
  }

  .roadmap-card-current .roadmap-card-numeral {
    background-image: linear-gradient(
      180deg,
      #fff 0%,
      rgb(147 197 253 / 55%) 55%,
      rgb(255 255 255 / 4%) 100%
    );
  }

  .roadmap-card-current .roadmap-card-mark {
    color: rgb(147 197 253 / 9%);
  }

  .roadmap-card-current .roadmap-card-icon {
    border-color: rgb(255 255 255 / 14%);
    background: rgb(255 255 255 / 8%);
    color: #fff;
  }

  .roadmap-card-current .roadmap-card-label {
    color: rgb(255 255 255 / 55%);
  }

  .roadmap-card-current .roadmap-card-text {
    color: rgb(255 255 255 / 66%);
  }

  /* The fork */
  .roadmap-future {
    grid-area: 1 / 1;
    opacity: var(--future-opacity, 0);
    transform: translate3d(0, var(--future-y, 40px), 0);
    visibility: var(--future-visibility, hidden);
  }

  [data-roadmap-reveal] {
    opacity: var(--reveal, 0);
    filter: blur(calc((1 - var(--reveal, 0)) * 6px));
    transform: translate3d(0, calc((1 - var(--reveal, 0)) * 18px), 0);
  }

  .roadmap-future-header {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .roadmap-future-intro {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(0 0 0 / 56%);
  }

  .roadmap-fork {
    display: none;
  }

  .roadmap-fork-line,
  .roadmap-fork-mask {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .roadmap-fork-line {
    stroke: rgb(15 23 42 / 55%);
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--draw-offset, 1);
  }

  .roadmap-fork-dotted {
    stroke-dasharray: 0 6;
    stroke-dashoffset: 0;
    stroke-width: 2;
  }

  .roadmap-fork-mask {
    stroke: #fff;
    stroke-width: 12;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--draw-offset, 1);
  }

  .roadmap-paths {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .roadmap-path {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .roadmap-path-card {
    border: 1px solid rgb(0 0 0 / 9%);
    border-radius: 0.875rem;
    background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      0 18px 44px -22px rgb(15 23 42 / 22%);
    padding: 1rem 1.125rem;
  }

  .roadmap-path-card-dotted {
    border-style: dashed;
    border-color: rgb(0 0 0 / 22%);
    background: rgb(255 255 255 / 45%);
    box-shadow: none;
  }

  .roadmap-path-icon {
    display: none;
    width: 2.25rem;
    height: 2.25rem;
    border-color: transparent;
    background: #0d0d0d;
    color: #fff;
  }

  .roadmap-path-icon-dotted {
    border: 1px dashed rgb(0 0 0 / 28%);
    background: rgb(0 0 0 / 3%);
    color: rgb(0 0 0 / 66%);
  }

  .roadmap-path-title {
    margin-top: 0.25rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #0d0d0d;
  }

  .roadmap-path-text {
    display: -webkit-box;
    margin-top: 0.4rem;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(0 0 0 / 56%);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .roadmap-path-link {
    width: 1px;
