---
const createSeededRandom = (seed: number) => {
  let state = seed;

  return () => {
    state = (state * 48271) % 2147483647;
    return state / 2147483647;
  };
};

const random = createSeededRandom(24051998);
const round = (value: number) => Number(value.toFixed(2));
const starColumns = 20;
const starRows = 10;

const stars = Array.from({ length: starColumns * starRows }, (_, index) => {
  const column = index % starColumns;
  const row = Math.floor(index / starColumns);
  const distributionRank = (index * 73) % (starColumns * starRows);
  const duration = round(13 + random() * 10);

  return {
    x: round(((column + 0.15 + random() * 0.7) / starColumns) * 100),
    y: round(((row + 0.15 + random() * 0.7) / starRows) * 100),
    size: round(0.7 + random() * 1.2),
    duration,
    delay: round(-random() * duration),
    lightBase: round(0.18 + random() * 0.2),
    darkBase: round(0.34 + random() * 0.28),
    lightPeak: round(0.58 + random() * 0.22),
    darkPeak: round(0.8 + random() * 0.18),
    twinkles: distributionRank < 64,
    desktopOnly: distributionRank >= 120,
    accent: (index * 31) % 17 < 3,
  };
});

const shootingStars = [
  {
    x: -16,
    y: 12,
    duration: 37,
    delay: -9,
    distance: 68,
    drop: 29,
    angle: 23,
    trail: 118,
  },
  {
    x: 48,
    y: -5,
    duration: 53,
    delay: -34,
    distance: 52,
    drop: 22,
    angle: 23,
    trail: 92,
  },
];
---

<div class="living-starfield" aria-hidden="true">
  {
    stars.map((star) => (
      <span
        class:list={[
          "living-starfield__star",
          {
            "living-starfield__star--twinkle": star.twinkles,
            "living-starfield__star--desktop-only": star.desktopOnly,
            "living-starfield__star--accent": star.accent,
          },
        ]}
        style={`--star-x:${star.x}%;--star-y:${star.y}%;--star-size:${star.size}px;--star-duration:${star.duration}s;--star-delay:${star.delay}s;--star-light-base:${star.lightBase};--star-dark-base:${star.darkBase};--star-light-peak:${star.lightPeak};--star-dark-peak:${star.darkPeak};`}
      />
    ))
  }

  {
    shootingStars.map((star) => (
      <span
        class="living-starfield__shooting-star"
        style={`--shooting-x:${star.x}%;--shooting-y:${star.y}%;--shooting-duration:${star.duration}s;--shooting-delay:${star.delay}s;--shooting-distance:${star.distance}vw;--shooting-drop:${star.drop}vw;--shooting-angle:${star.angle}deg;--shooting-trail:${star.trail}px;`}
      />
    ))
  }
</div>

<style>
  .living-starfield {
    --living-shooting-core-color: 15 23 42;
    --living-shooting-tail-color: 37 99 235;

    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(html.dark) .living-starfield {
    --living-shooting-core-color: 255 255 255;
    --living-shooting-tail-color: 147 197 253;
  }

  .living-starfield__shooting-star {
    position: absolute;
    top: var(--shooting-y);
    left: var(--shooting-x);
    width: clamp(72px, var(--shooting-trail), 128px);
    height: 3px;
    opacity: 0;
    transform: translate3d(0, 0, 0) rotate(var(--shooting-angle));
    transform-origin: right center;
    will-change: opacity, transform;
    animation: living-starfield-shoot var(--shooting-duration) linear
      var(--shooting-delay) infinite;
  }

  .living-starfield__shooting-star::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(var(--living-shooting-tail-color) / 3%) 22%,
      rgb(var(--living-shooting-tail-color) / 20%) 68%,
      rgb(var(--living-shooting-core-color) / 92%) 100%
    );
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
    content: "";
    filter: drop-shadow(
      0 0 3px rgb(var(--living-shooting-tail-color) / 38%)
    );
  }

  .living-starfield__shooting-star::after {
    position: absolute;
    top: 50%;
    right: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgb(var(--living-shooting-core-color));
    box-shadow:
      0 0 3px rgb(var(--living-shooting-core-color) / 95%),
      0 0 8px rgb(var(--living-shooting-tail-color) / 72%),
      0 0 15px rgb(var(--living-shooting-tail-color) / 34%);
    content: "";
    transform: translateY(-50%);
  }

  @keyframes living-starfield-shoot {
    0%,
    84% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(var(--shooting-angle));
    }

    84.35% {
      opacity: 0.2;
    }

    85% {
      opacity: 0.92;
    }

    87.25% {
      opacity: 0.78;
    }

    88.5% {
      opacity: 0;
      transform: translate3d(
          var(--shooting-distance),
          var(--shooting-drop),
          0
        )
        rotate(var(--shooting-angle));
    }

    100% {
      opacity: 0;
      transform: translate3d(
          var(--shooting-distance),
          var(--shooting-drop),
          0
        )
        rotate(var(--shooting-angle));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .living-starfield__shooting-star {
      display: none;
    }
  }
</style>
