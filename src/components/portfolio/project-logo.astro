---
// A project logo. SVGs are served as they are; raster logos go through the
// image pipeline so the browser gets a small WebP instead of the source PNG.
// With `logoDark`, each theme shows its own version of the logo.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  logo: ImageMetadata;
  logoDark?: ImageMetadata;
  alt: string;
  class?: string;
}

const { logo, logoDark, alt, class: className } = Astro.props;

const variants = logoDark
  ? [
      { src: logo, theme: "project-logo-light" },
      { src: logoDark, theme: "project-logo-dark" },
    ]
  : [{ src: logo, theme: undefined }];
---

{
  variants.map(({ src, theme }) =>
    src.format === "svg" ? (
      <img
        src={src.src}
        alt={alt}
        width={src.width}
        height={src.height}
        loading="lazy"
        decoding="async"
        draggable="false"
        class:list={[className, theme]}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        width={480}
        widths={[240, 360, 480]}
        sizes="12rem"
        loading="lazy"
        decoding="async"
        draggable="false"
        class:list={[className, theme]}
      />
    ),
  )
}
