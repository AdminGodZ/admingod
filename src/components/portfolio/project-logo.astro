---
// A project logo. SVGs are served as they are; raster logos go through the
// image pipeline so the browser gets a small WebP instead of the source PNG.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  logo: ImageMetadata;
  alt: string;
  class?: string;
}

const { logo, alt, class: className } = Astro.props;
---

{
  logo.format === "svg" ? (
    <img
      src={logo.src}
      alt={alt}
      width={logo.width}
      height={logo.height}
      loading="lazy"
      decoding="async"
      draggable="false"
      class={className}
    />
  ) : (
    <Image
      src={logo}
      alt={alt}
      width={480}
      widths={[240, 360, 480]}
      sizes="12rem"
      loading="lazy"
      decoding="async"
      draggable="false"
      class={className}
    />
  )
}
