---
import { ArrowUpRight } from "lucide-react";
import { formatResearchDate, type ResearchEntry } from "@/lib/research";

interface Props {
  entry: ResearchEntry;
}

const { entry } = Astro.props;
const { data } = entry;
---

<a
  href={`/research/${entry.id}`}
  class="project-card group relative flex h-full min-h-[290px] flex-col overflow-hidden rounded-lg border border-black/8 bg-white p-6 text-left no-underline shadow-[0_18px_38px_rgba(0,0,0,0.08)] ring-1 ring-white/80 dark:border-white/10 dark:bg-[#0a0a0a] dark:shadow-[0_18px_38px_rgba(0,0,0,0.6)] dark:ring-white/8 sm:p-7"
>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(37,99,235,0.045)_0%,rgba(255,255,255,0)_46%,rgba(0,0,0,0.025)_100%)] dark:bg-[linear-gradient(145deg,rgba(96,165,250,0.06)_0%,rgba(255,255,255,0)_50%)]"></div>
  <span class="pointer-events-none absolute -top-8 -right-3 select-none text-[11rem] font-black leading-none text-black/[0.025] transition-transform duration-500 group-hover:scale-105 dark:text-white/[0.035]" aria-hidden="true">Σ</span>

  <div class="relative mt-2">
    <p class="text-sm font-semibold text-blue-700/72 dark:text-blue-300/72">
      {data.problem}
    </p>
    <h3 class="mt-3 text-2xl font-black leading-[1.08] tracking-[-0.025em] text-black dark:text-white sm:text-3xl">
      {data.title}
    </h3>
    <p class="mt-4 line-clamp-2 max-w-3xl leading-7 text-black/56 dark:text-white/56">
      {data.summary}
    </p>
  </div>

  <div class="relative mt-auto flex items-end justify-between gap-5 border-t border-black/8 pt-6 dark:border-white/10">
    <div class="text-sm text-black/48 dark:text-white/48">
      <p>{data.field}</p>
      <p class="mt-1">v{data.version} · {formatResearchDate(data.updatedAt)}</p>
    </div>
    <ArrowUpRight className="project-card-arrow size-5 shrink-0 text-black dark:text-white" aria-hidden="true" />
  </div>
</a>
